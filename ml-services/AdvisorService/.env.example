# Copy to ".env" next to compose.yaml (ml-services/.env). Never commit .env.
# --- required ---
SERVICE_SECRET=change-me-long-random-string      # the backend sends this in x-service-secret
ADMIN_KEY=change-me-a-different-long-string      # admin calls also need this in x-admin-key

# --- model providers (leave empty to disable that provider) ---
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
TAVILY_API_KEY=

# --- backend the advisor reads market data from ---
BACKEND_BASE_URL=http://host.docker.internal:8000

# --- embeddings: ollama (needs the "local" compose profile) or gemini ---
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text

# --- ports ---
ADVISOR_REST_PORT=8001
